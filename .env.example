# General Expansions Workflows
APP_URL=https://www.generalexpansions.com
APP_NAME=General Expansions
APP_TIMEZONE=Asia/Manila
ORG_DOMAIN=spxexpress.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.generalexpansions.com/api/auth/callback

# Session
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_DAYS=7

# Database
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/app.db

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage

# Email
EMAIL_PROVIDER=console
SMTP_FROM=General Expansions <no-reply@generalexpansions.com>

# Reminders
REMINDER_AFTER_DAYS=1
REMINDER_EVERY_DAYS=1
ESCALATION_AFTER_DAYS=7

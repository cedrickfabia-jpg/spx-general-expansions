rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['ADMINISTRATOR']);
    }

    function isRequester(requestId) {
      return request.auth != null && get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid;
    }

    function inList(list, value) {
      return list != null && list.hasAny([value]);
    }

    function canAccessRequest(requestId) {
      return isAdmin()
        || get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid
        || inList(get(/databases/$(database)/documents/requests/$(requestId)).data.approverUserIds, request.auth.uid)
        || inList(get(/databases/$(database)/documents/requests/$(requestId)).data.watcherUserIds, request.auth.uid);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid || isAdmin();
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.roles == resource.data.roles && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    match /hubs/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || request.resource.data.code in ['NOL', 'SOL', 'NCR', 'VIS', 'MIN'];
      allow update, delete: if isAdmin();
    }

    match /hubs/{hubId}/routes/{slot} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /requests/{id} {
      allow read: if isAdmin() || request.auth.uid == resource.data.requesterId || inList(resource.data.approverUserIds, request.auth.uid) || inList(resource.data.watcherUserIds, request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || resource.data.requesterId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /steps/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update: if isAdmin() || resource.data.approverId == request.auth.uid || isRequester(resource.data.requestId);
      allow delete: if isAdmin();
    }

    match /documents/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update: if canAccessRequest(resource.data.requestId);
      allow delete: if isAdmin();
    }

    match /comments/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /requestRevisions/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /actions/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /errorLogs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}

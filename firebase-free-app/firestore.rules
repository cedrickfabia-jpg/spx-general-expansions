        'karlo.cajucom@spxexpress.com', 'ricky.delrosario@spxexpress.com', 'joana.aniciete@spxexpress.com', 'davis.gaspar@spxexpress.com', 'gerom.bangayan@spxexpress.com',
        'pablo.domingo@spxexpress.com', 'ralph.togmoy@shopee.com', 'allen.ordonez@spxexpress.com', 'jose.cruz@spxexpress.com', 'edward.rosales@spxexpress.com',
        'jayar.cortez@spxexpress.com', 'adorabelle.aparicio@spxexpress.com', 'joanna.aguilar@spxexpress.com', 'mario.padua@spxexpress.com', 'rogien.bornales@spxexpress.com',
        'peter.adlaon@spxexpress.com', 'daphne.serrano@spxexpress.com', 'arnold.javier@spxexpress.com', 'neil.esperanza@spxexpress.com', 'nikki.moradas@spxexpress.com',
        'mylene.quise@spxexpress.com', 'charlene.aguaviva@spxexpress.com', 'romeo.gabas@spxexpress.com', 'mary.tan@spxexpress.com', 'marco.joseph@spxexpress.com',
        'glenn.santos@spxexpress.com', 'spxexpansions.ph@spxexpress.com', 'charmaine.demorar@spxexpress.com', 'audrey.masakayan@spxexpress.com', 'precious.soriano@spxexpress.com',
        'angelou.madamo@spxexpress.com', 'kisha.salunga@spxexpress.com', 'martin.yu@shopee.com'
      ];
    }

    function requestsPrivilegedRole(data) {
      return data.isAdmin == true
        || (('roles' in data) && data.roles.hasAny(['ADMINISTRATOR', 'HOD_APPROVER', 'HOD_1', 'HOD_2']));
    }

    function canAccessRequest(requestId) {
      return isAdmin()
        || get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid
        || inList(get(/databases/$(database)/documents/requests/$(requestId)).data.approverUserIds, request.auth.uid)
        || inList(get(/databases/$(database)/documents/requests/$(requestId)).data.watcherUserIds, request.auth.uid);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        || (request.auth.uid == uid && isBootstrapAdmin())
        || (request.auth.uid == uid && isApprovedEmail() && !requestsPrivilegedRole(request.resource.data));
      allow update: if isAdmin()
        || (request.auth.uid == uid && isBootstrapAdmin())
        || (request.auth.uid == uid && request.resource.data.roles == resource.data.roles && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    match /hubs/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || request.resource.data.code in ['NOL', 'SOL', 'NCR', 'VIS', 'MIN'];
      allow update, delete: if isAdmin();
    }

    match /hubs/{hubId}/routes/{slot} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /requests/{id} {
      allow read: if isAdmin() || request.auth.uid == resource.data.requesterId || inList(resource.data.approverUserIds, request.auth.uid) || inList(resource.data.watcherUserIds, request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || resource.data.requesterId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /steps/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update: if isAdmin() || resource.data.approverId == request.auth.uid || isRequester(resource.data.requestId);
      allow delete: if isAdmin();
    }

    match /documents/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update: if canAccessRequest(resource.data.requestId);
      allow delete: if isAdmin();
    }

    match /comments/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /requestRevisions/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /actions/{id} {
      allow read: if canAccessRequest(resource.data.requestId);
      allow create: if canAccessRequest(request.resource.data.requestId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /errorLogs/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /archivedRequests/{id} {
      allow read, write: if isAdmin();
    }
  }
}
